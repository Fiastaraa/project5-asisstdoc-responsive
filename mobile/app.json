{
  "expo": {
    "name": "AssistDoc",
    "slug": "assistdoc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "assistdoc",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/hero.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5E9D8"
    },
    "android": {
      "package": "com.assistdoc.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#F5E9D8"
      }
    },
    "ios": {
      "bundleIdentifier": "com.assistdoc.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
